---
import Layout from '../../../layouts/Layout.astro';
import OffreCard from '../../../components/OffreCard.astro';
import { getOffres } from '../../../js/backend.mjs';

const { surface } = Astro.params; 
const allOffres = await getOffres();


const filteredOffres = allOffres.filter(offre => offre.surface >= Number(surface));
---

<Layout titre={`Maisons ≥ ${surface} m²`}>
  <h1 class="text-4xl font-bold text-cyan-400 mb-4">Maisons avec surface ≥ {surface} m²</h1>

  {filteredOffres.length === 0 ? (
    <p class="text-green-900">Aucune maison ne correspond à ce critère.</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {filteredOffres.map(offre => (
        <OffreCard offre={offre} />
      ))}
    </div>
  )}
</Layout>
