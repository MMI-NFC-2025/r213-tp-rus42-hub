---
import Layout from '../../layouts/Layout.astro';
import PbImage from '../../components/PbImage.astro';
import { getOffre } from '../../js/backend.mjs';

const { id } = Astro.params;
const offre = await getOffre(id);
---

{offre ? (
  <Layout titre={offre.nom_maison}>
    <h1 class="text-4xl font-extrabold text-yellow-400 mb-6">
      {offre.nom_maison}
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        {offre.images?.map((img: string) => (
     <PbImage record={offre} recordImage={img} width={400} height={300} />
     ))}

      </div>

    <ul class="space-y-2 text-green-900">
      <li><strong>Adresse :</strong> {offre.adresse}</li>
      <li><strong>Surface :</strong> {offre.surface} m²</li>
      <li><strong>Chambres :</strong> {offre.nbChambres}</li>
      <li><strong>Salles de bain :</strong> {offre.nbSdb}</li>
      <li><strong>Prix :</strong> {offre.prix} €</li>
    </ul>
  </Layout>
) : (
  <Layout titre="Offre introuvable">
    <h1 class="text-2xl font-bold text-red-500">Offre non trouvée</h1>
    <p>Cette maison n'existe pas ou a été supprimée.</p>
  </Layout>
)}
